# Local development
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Supabase Auth Google 로그인용 공개 설정입니다. service_role 키는 절대 프론트에 넣지 마세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Identity Services(ID 토큰) 로그인용 OAuth 클라이언트 ID. 공개값이라 프론트에 노출돼도 안전합니다.
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보에서 발급받은 웹 클라이언트 ID.
VITE_GOOGLE_CLIENT_ID=

# Vercel production에서는 실제 Render API 주소로 교체합니다.
# VITE_API_BASE_URL=https://your-api.onrender.com/api/v1

# 네이버 로그인 — https://developers.naver.com 애플리케이션의 Client ID (공개값, 프론트에 노출되어도 안전)
# Callback URL을 애플리케이션 설정에 {서비스 주소}/auth/naver/callback 으로 등록해야 합니다.
VITE_NAVER_CLIENT_ID=
