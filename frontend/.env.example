# Local development
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Vercel production에서는 실제 Render API 주소로 교체합니다.
# VITE_API_BASE_URL=https://your-api.onrender.com/api/v1

# 네이버 로그인 — https://developers.naver.com 애플리케이션의 Client ID (공개값, 프론트에 노출되어도 안전)
# Callback URL을 애플리케이션 설정에 {서비스 주소}/auth/naver/callback 으로 등록해야 합니다.
VITE_NAVER_CLIENT_ID=
